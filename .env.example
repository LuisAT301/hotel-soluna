# Copie este archivo con el nombre .env y cambie TODOS los valores.
# El archivo .env nunca se sube al repositorio (está en .gitignore).
# Para generar valores aleatorios en Mac, Linux o Git Bash:  openssl rand -hex 24

# Administrador de PostgreSQL (solo lo usa el contenedor de la base)
POSTGRES_PASSWORD=cambie-esta-clave-admin

# Usuario de la base con el que se conecta la API (privilegios mínimos)
DB_APP_PASSWORD=cambie-esta-clave-api

# Usuario de solo lectura para los respaldos
DB_RESPALDO_PASSWORD=cambie-esta-clave-respaldo

# Clave para firmar los tokens de sesión (mínimo 32 caracteres)
JWT_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria

# Contraseña de las cuentas de demostración (mínimo 8 caracteres)
DEMO_PASSWORD=cambie-esta-clave-demo

# Llave de comercio con la que la API se identifica ante la pasarela de pago
# y Hacienda (simuladas en el prototipo)
SERVICIOS_LLAVE=cambie-esta-llave-de-servicios

# Secreto compartido con la OTA para firmar sus avisos de reserva
OTA_SECRETO=cambie-este-secreto-de-la-ota
