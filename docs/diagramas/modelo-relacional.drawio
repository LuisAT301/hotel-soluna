r=#555555;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v27" target="v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="378.0" y="485.0"/><mxPoint x="378.0" y="151.0"/></Array></mxGeometry></mxCell><mxCell id="e171" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v120" target="v129"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1272.0" y="195.0"/><mxPoint x="1272.0" y="371.0"/></Array></mxGeometry></mxCell><mxCell id="e172" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v138" target="v129"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300.0" y="541.0"/><mxPoint x="1300.0" y="371.0"/></Array></mxGeometry></mxCell><mxCell id="e173" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v97" target="v62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="835.0" y="663.0"/><mxPoint x="835.0" y="151.0"/></Array></mxGeometry></mxCell><mxCell id="e174" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;startArrow=ERzeroToOne;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v147" target="v62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="858.0" y="723.0"/><mxPoint x="858.0" y="151.0"/></Array></mxGeometry></mxCell><mxCell id="e175" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;startArrow=ERzeroToOne;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v51" target="v62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="458.0" y="893.0"/><mxPoint x="458.0" y="151.0"/></Array></mxGeometry></mxCell><mxCell id="e176" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v53" target="v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="18.0" y="915.0"/><mxPoint x="18.0" y="151.0"/></Array></mxGeometry></mxCell><mxCell id="v177" value="&lt;b&gt;Restricciones destacadas&lt;/b&gt;&lt;br&gt;reservas.sin_traslape: EXCLUDE USING gist (habitacion_id WITH =,&lt;br&gt;&amp;nbsp;&amp;nbsp;daterange(fecha_entrada, fecha_salida) WITH &amp;amp;&amp;amp;) WHERE estado &amp;lt;&amp;gt; 'cancelada'.&lt;br&gt;&amp;nbsp;&amp;nbsp;Impide la sobreventa aunque dos réplicas reserven a la vez.&lt;br&gt;CHECK: fecha_salida &amp;gt; fecha_entrada; facturas.total = subtotal + impuesto;&lt;br&gt;&amp;nbsp;&amp;nbsp;rol, canal, estado, temporada y estado_limpieza en listas cerradas.&lt;br&gt;resenas.reserva_id es UNIQUE: una reseña por estadía; calificacion entre 1 y 5.&lt;br&gt;facturas.consecutivo sale de la secuencia consecutivo_factura.&lt;br&gt;bitacora.entidad + entidad_id: referencia genérica, sin clave foránea." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#F7F9FC;strokeColor=#C9D3E3;" vertex="1" parent="1"><mxGeometry x="40.0" y="1030.0" width="840.0" height="189.0" as="geometry"/></mxCell><mxCell id="v178" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Pata de gallo: cero o muchos; círculo y barra: cero o uno; dos barras: exactamente uno.&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clave primaria, &lt;b&gt;FK&lt;/b&gt; clave foránea, &lt;b&gt;UQ&lt;/b&gt; única, &lt;i&gt;NULL&lt;/i&gt; admite nulos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920.0" y="1030.0" width="400.0" height="70.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
