dle;" vertex="1" parent="1"><mxGeometry x="888.5" y="439.1" width="20.0" height="22.0" as="geometry"/></mxCell><mxCell id="v88" value="1" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#B00020;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620.0" y="228.5" width="20.0" height="22.0" as="geometry"/></mxCell><mxCell id="v89" value="Hotel Soluna: modelo entidad-relación" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#2B4C7E;align=left;" vertex="1" parent="1"><mxGeometry x="40.0" y="25.0" width="700.0" height="30.0" as="geometry"/></mxCell><mxCell id="v90" value="Notación de Chen. Se muestran los atributos principales; el modelo relacional detalla todas las columnas." style="text;html=1;fontSize=13;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="40.0" y="56.0" width="900.0" height="24.0" as="geometry"/></mxCell><mxCell id="v91" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Línea simple: participación parcial. Línea doble: participación total.&lt;br&gt;&lt;u&gt;Subrayado&lt;/u&gt;: atributo clave. Subrayado punteado: clave parcial.&lt;br&gt;Rectángulo doble: entidad débil. Rombo doble: relación identificadora.&lt;br&gt;&lt;b&gt;1, N&lt;/b&gt;: cardinalidad." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#F7F9FC;strokeColor=#C9D3E3;" vertex="1" parent="1"><mxGeometry x="1570.0" y="1010.0" width="500.0" height="112.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
